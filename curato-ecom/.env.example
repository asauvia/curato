# Firebase web configuration for the Curato storefront.
# Fill these in when the Curato Firebase project is created.
# Used with: flutter run -d chrome --dart-define-from-file=.env
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
